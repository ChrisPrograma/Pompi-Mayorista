{
  "name": "gestion-pompi-mascotas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "Sistema de gestión para venta mayorista de accesorios para mascotas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test:node": "node scripts/tests.mjs",
    "verificar": "node scripts/verificar-imports.mjs",
    "build:bun": "npm run typecheck:produccion && npm run typecheck:completo && node scripts/build.mjs",
    "typecheck:sin-npm": "tsc -p tsconfig.verificacion.json",
    "typecheck:completo": "tsc -p tsconfig.completo.json",
    "antes-de-subir": "npm run typecheck:produccion && npm run typecheck:completo && npm run test:node",
    "typecheck:produccion": "tsc -p tsconfig.produccion.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
